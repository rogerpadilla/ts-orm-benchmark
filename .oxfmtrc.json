{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "singleQuote": true,
  "sortPackageJson": false,
  "sortImports": {
    "newlinesBetween": false,
    "partitionByNewline": true,
    "ignoreCase": false
  },
  "ignorePatterns": [
    "README.md",
    "chart.html",
    "results.js",
    "report.json",
    "type-safety/verdicts.json",
    "rename-safety/verdicts.json",
    "rename-safety/prisma/generated",
    "rename-safety/renamed",
    "src/generated"
  ],
  "overrides": [
    {
      "files": ["type-safety/**", "rename-safety/**"],
      "options": {
        "printWidth": 80,
        "objectWrap": "collapse"
      }
    }
  ]
}
