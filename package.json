{
  "name": "ts-orm-benchmark",
  "version": "0.8.2",
  "description": "⚡ TypeScript ORM benchmark: what each one costs on a full PostgreSQL round trip. UQL vs Prisma vs Sequelize vs TypeORM vs MikroORM vs Drizzle",
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "bench": "bun scripts/flow-bench.ts",
    "ts": "tsc --noEmit",
    "lint": "biome check",
    "lint.fix": "biome check --write --unsafe"
  },
  "keywords": [
    "orm",
    "benchmark",
    "typescript",
    "ts",
    "node",
    "bun",
    "deno",
    "ts",
    "postgres",
    "prisma",
    "typeorm",
    "drizzle",
    "mikro-orm",
    "sequelize",
    "uql",
    "performance"
  ],
  "author": "Roger Padilla <sonemonu@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@mikro-orm/core": "^7.1.12",
    "@mikro-orm/postgresql": "^7.1.12",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@types/bun": "^1.3.14",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0",
    "prisma": "7.9.1",
    "sequelize": "^6.37.8",
    "typeorm": "^1.1.0",
    "typescript": "^7.0.2",
    "uql-orm": "0.28.1"
  }
