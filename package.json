{
  "name": "ts-orm-benchmark",
  "version": "0.11.0",
  "description": "TypeScript ORM benchmark: what each one costs on a full PostgreSQL round trip, and which mistakes its types catch. Drizzle vs MikroORM vs Prisma vs Sequelize vs TypeORM vs UQL",
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "bench": "bun scripts/flow-bench.ts",
    "bench.runtimes": "bun scripts/runtime-bench.ts",
    "bench.memory": "bun scripts/memory-bench.ts",
    "bench.types": "bun scripts/type-check.ts",
    "bench.renames": "bun scripts/rename-check.ts",
    "ts": "tsc --noEmit",
    "lint": "oxlint && oxfmt --check",
    "lint.fix": "oxlint --fix && oxfmt"
  },
  "keywords": [
    "orm",
    "benchmark",
    "typescript",
    "ts",
    "node",
    "bun",
    "postgres",
    "prisma",
    "typeorm",
    "drizzle",
    "mikro-orm",
    "sequelize",
    "uql",
    "performance",
    "type-safety"
  ],
  "author": "Roger Padilla <sonemonu@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@mikro-orm/core": "7.2.5",
    "@mikro-orm/postgresql": "7.2.5",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@prisma/language-server": "31.13.0",
    "@types/bun": "^1.4.4",
    "drizzle-orm": "0.45.4",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "pg": "8.23.1",
    "prisma": "7.10.1",
    "sequelize": "6.37.8",
    "typeorm": "1.1.2",
    "typescript": "7.0.2",
    "uql-orm": "0.105.0"
  }
}
