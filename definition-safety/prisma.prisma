// The same model as every other file here, checked by `prisma validate`: Prisma's definitions are not
// TypeScript, and its validator is what runs before anything is generated from them.

datasource db {
  provider = "postgresql"
}

enum Status {
  draft
  published
}

model Company {
  id    Int    @id @default(autoincrement())
  name  String

  // Inverse side naming a missing relation | "staf" -> "staff"
  users User[] @relation("staf")
}

model User {
  id        Int      @id @default(autoincrement())

  // Misspelled option on a column | @uniqe -> @unique
  name      String   @uniqe

  // Nullable column declared always present | n/a: the client is generated from the schema, so it cannot disagree with it
  email     String?

  // Default outside the column's enum | @default(archived) -> @default(draft)
  status    Status   @default(archived)

  // Default of the wrong type | @default("zero") -> @default(0)
  createdAt Int      @default("zero")

  // Text length on a numeric column | @db.VarChar(10) -> @db.Integer
  score     Int?     @db.VarChar(10)

  // Declared type disagreeing with its column | n/a: the client is generated from the schema, so it cannot disagree with it
  nickname  String?

  // Optimistic lock on a text column | n/a: Prisma has no optimistic lock

  // Generated column reading a misspelled column | n/a: Prisma schemas declare no generated columns

  // Foreign key of another type than the key it references | companyId String? -> companyId Int?
  companyId String?

  // Foreign key naming a missing column | fields: [companyid] -> fields: [companyId]
  company   Company? @relation("staff", fields: [companyid], references: [id])

  // Index on a missing column | emial -> email
  @@index([emial])
}
